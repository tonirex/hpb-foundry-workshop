// sponsor — reference environment from the earlier 6-person delivery (Azure sponsorship subscription, separate Entra
// tenant). Not used or re-validated by the HPB MCAPS delivery. IDs, capacity, facilitator UPNs and budget are read from
// content/config/workshop.yaml (environments.sponsor / models.units.sponsor). Differs from mcaps.bicepparam ONLY in:
// environmentName, the yaml environment key and tags.
// Preserve the earlier France Central Search location in config; no sponsor deployment is authorized.
using '../main.bicep'

var cfg = loadYamlContent('../../content/config/workshop.yaml', '$.environments.sponsor')
var units = loadYamlContent('../../content/config/workshop.yaml', '$.models.units.sponsor')

param environmentName = 'sponsor'
param location = 'swedencentral'
param principalId = readEnvironmentVariable('AZURE_PRINCIPAL_ID', '')
param principalType = readEnvironmentVariable('AZURE_PRINCIPAL_TYPE', 'User')

// Fabric capacity admins = UPNs of MEMBER work accounts in the sponsor tenant (not guests, not personal accounts:
// Fabric refuses an outlook.com account, ASSUMPTIONS.md 10.1).
param fabricAdminMembers = cfg.facilitator_upns
param fabricBridge = bool(readEnvironmentVariable('FABRIC_BRIDGE', 'true'))
param projectMode = readEnvironmentVariable('MODE', 'shared-project')

param searchLocation = cfg.search_location
param searchSku = readEnvironmentVariable('SEARCH_SKU', 'basic')
param fabricSku = readEnvironmentVariable('FABRIC_SKU', 'F2')
param chatTpmCapThousands = units.default
param toolsTpmCapThousands = units.tools
param embeddingTpmCapThousands = units.embeddings
param mcpMinReplicas = int(readEnvironmentVariable('MCP_MIN_REPLICAS', '0'))
param mcpImage = readEnvironmentVariable('SERVICE_MCP_ACTIVITIES_IMAGE_NAME', '')
// Lab 4 DevUI in a browser (LAB4_DEVUI=false skips it). The token is generated by scripts/select-params.py.
param lab4DevUi = bool(readEnvironmentVariable('LAB4_DEVUI', 'true'))
param devuiToken = readEnvironmentVariable('LIVEWELL_DEVUI_TOKEN', '')
param devuiImage = readEnvironmentVariable('SERVICE_LAB4_DEVUI_IMAGE_NAME', '')
param devuiMinReplicas = int(readEnvironmentVariable('DEVUI_MIN_REPLICAS', '0'))
param devuiSeats = int(readEnvironmentVariable('DEVUI_SEATS', '8'))

param budgetAmountUsd = cfg.budget_usd
param budgetAlertThresholdsUsd = cfg.budget_alerts_usd
param budgetContactEmails = cfg.budget_contacts
param budgetStartDate = readEnvironmentVariable('BUDGET_START_DATE', '')

param extraTags = {
  purpose: 'delivery'
  owner: 'antonia-chen'
  customer: 'hpb'
}

// Only if the sponsor tenant has a policy forcing storage publicNetworkAccess=Disabled (see mcaps.bicepparam).
param storagePolicyOptOutTag = cfg.storage_policy_opt_out_tag

// Allow = Entra-only public access so Lab 2 can publish evaluation runs; Deny = Search + trusted services only.
param storageNetworkDefaultAction = 'Allow'

// First provision of an environment (no AZURE_AI_ACCOUNT_NAME yet): ARM preflight rejects a guardrail policy whose
// blocklist is created in the same deployment, so the policy starts unlinked and apply-guardrail.py links it.
param guardrailLinkBlocklist = !empty(readEnvironmentVariable('AZURE_AI_ACCOUNT_NAME', ''))
