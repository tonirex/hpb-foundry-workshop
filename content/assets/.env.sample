# LiveWell Builder rail settings. Copy to content/assets/.env (gitignored) and fill in the first two lines:
#   cp content/assets/.env.sample content/assets/.env
# Then run  python content/assets/check_setup.py  until it says "All set".
# No keys or passwords go here: you sign in with  az login  and the tools are found by name in the project.

# 1. Your own initials, 2-8 letters or digits (e.g. INITIALS=jt). Your agents are named livewell-<INITIALS>-<role>.
INITIALS=KN

# 2. The whole "Project endpoint" row on the facilitator values sheet.
FOUNDRY_PROJECT_ENDPOINT=https://aif-hpb-livewell-mcaps.services.ai.azure.com/api/projects/livewell-workshop

# Leave false. Set to true only when the facilitator says the Fabric step is on (Lab 3 Fabric step, Lab 4 insights).
FABRIC_BRIDGE=false

# Optional overrides (defaults come from content/config/workshop.yaml):
# LIVEWELL_MODEL=gpt-5-mini            # Labs 0-2, the Lab 3 specialists and Lab 4
# LIVEWELL_TOOLS_MODEL=gpt-4.1-mini    # the Lab 3 coach (function, OpenAPI, A2A and Fabric tools) and eval judges
# LIVEWELL_REASONING_EFFORT=low        # gpt-5-mini only: minimal, low, medium or high
# LIVEWELL_TIMEOUT=180                 # seconds per agent call; loaded when the helper starts
# LIVEWELL_FABRIC_TIMEOUT=300          # seconds per Fabric call
# AZURE_TENANT_ID=                     # only if az login picked a different tenant
